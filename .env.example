# ---------------------------------------------------------------------------
# Copie para .env  ->  cp .env.example .env
# NUNCA commite o .env. Nenhuma destas chaves vai para o front-end.
# ---------------------------------------------------------------------------

APP_ENV=local
APP_VERSION=0.1.0

# --- Provedor de LLM -------------------------------------------------------
# Trocar de provedor = trocar estas duas linhas.
#   openai    -> gpt-4.1-mini | gpt-4o-mini
#   anthropic -> claude-haiku-4-5 | claude-sonnet-4-6
#   deepseek  -> deepseek-chat | deepseek-reasoner
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# --- Chaves (preencha apenas a do provedor ativo) --------------------------
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Caminhos (sobrescritos pelo compose) ----------------------------------
DATABASE_PATH=/data/loja.db
LOGS_DIR=/app/logs

# --- CORS (interface) ------------------------------------------------------
# Origens liberadas, separadas por virgula. Vazio desliga o CORS.
# Padrao no codigo: 5173 (serve.py), 8080 (container nginx), 3000 e 4173 (dev).
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
